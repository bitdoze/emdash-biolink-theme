{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "emdash-biolink",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	// nodejs_compat_populate_process_env exposes Worker vars/secrets on
	// process.env, which is where EmDash reads EMDASH_SITE_URL at runtime.
	"compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "emdash-biolink",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "emdash-biolink-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
